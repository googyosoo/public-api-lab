# ===================================================
# BAUHAUS API LAB - 공공 API & 서비스 키 설정
# 여기에 발급받은 실제 API 키를 입력하시면 웹 애플리케이션 시작 시 자동으로 로드됩니다.
# ===================================================

# 1. 카카오 디벨로퍼스 REST API 키 (카카오 장소/지도/도서 검색)
VITE_KAKAO_KEY=

# 2. 공공데이터포털 기상청 단기예보 서비스키 (일반 인증키 - Encoding 또는 Decoding)
VITE_KMA_KEY=

# 3. 나이스 교육정보 개방포털 인증키
VITE_NEIS_KEY=

# 4. 한국환경공단 에어코리아 대기오염정보 서비스키
VITE_AIR_KEY=

# 5. 한국천문연구원 특일정보/출몰시각 서비스키
VITE_KASI_KEY=

# 6. 국립중앙도서관 국가서지 Open API 키
VITE_NL_KEY=

# 7. 디스코드 또는 슬랙 웹훅 URL
VITE_DISCORD_WEBHOOK_URL=

# 8. 구글 제미나이(Gemini) API 키
VITE_GEMINI_KEY=
